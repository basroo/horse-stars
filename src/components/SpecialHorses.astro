---
import { Image } from 'astro:assets';
import { horses } from '../data/collection';
import { homepageCardImages } from '../data/homepage-card-assets';
import Icon from './Icon.astro';
import type { Copy } from '../i18n';
interface Props { copy: Copy }
const { copy: t } = Astro.props;
const rarities = ['elite', 'epic', 'legend'] as const;
---
<section id="special-horses" class="special-section section-large" aria-labelledby="special-title">
  <div class="container">
    <div class="editorial-intro special-heading"><h2 id="special-title">{t.special.title}<br /><span>{t.special.accent}</span></h2><p class="section-description">{t.special.intro}</p></div>
  </div>
  <div class="rarity-procession" tabindex="0" role="region" aria-label={t.special.swipe}>
    {rarities.map((rarity, index) => {
      const horse = horses.find(h => h.rarity === rarity)!;
      return <article class={`special-card special-${rarity}`}>
        <div class="special-card-label"><span>0{index + 1}</span><span>{t.rarities[rarity]}</span><strong>{t.special.counts[rarity]}</strong><Icon name="star" /></div>
        <div class="special-card-art"><span class="rarity-orbit" aria-hidden="true"></span>{homepageCardImages[horse.images.card] ? <Image src={homepageCardImages[horse.images.card]} alt={`${horse.name} — ${t.rarities[rarity]}`} widths={[240,360,540,680]} sizes="(max-width: 639px) 65vw, 300px" width={300} loading="lazy" /> : <div class="horse-placeholder" role="img" aria-label={`${horse.name} — Horse Stars card artwork`}><span>HORSE<br />STARS</span><strong>{horse.id}</strong></div>}</div>
      </article>;
    })}
  </div>
</section>
