---
import { horses } from '../data/collection';
import { homepageCardImages } from '../data/homepage-card-assets';
import HorseCard from './HorseCard.astro';
import Icon from './Icon.astro';
import type { Copy, Locale } from '../i18n';
import { localizedPath } from '../i18n/paths';
interface Props { copy: Copy; locale?: Locale }
const { copy: t, locale = 'en' } = Astro.props;
const previewIds = ['HS001', 'HS009', 'HS011', 'HS016', 'HS051', 'HS052', 'HS069', 'HS085', 'HS093', 'HS102'];
const previewHorses = previewIds.map(id => horses.find(horse => horse.id === id)!);
---
<section id="collection" class="collection-section" aria-labelledby="collection-title">
  <div class="container">
    <div class="section-topline"><p class="eyebrow"><Icon name="star" />{t.collection.eyebrow}</p><span class="edition-label">01 / {t.collection.edition}</span></div>
    <div class="collection-heading"><h2 id="collection-title">{t.collection.title}<br /><span>{t.collection.titleAccent}</span><span class="heading-period">.</span></h2><p>{t.collection.description}</p></div>
    <div class="cards-toolbar"><span>{t.collection.preview}</span><div class="scroll-controls"><button data-scroll="-1" aria-label={t.collection.previous}><Icon class="rotate-180" /></button><button data-scroll="1" aria-label={t.collection.next}><Icon /></button></div></div>
  </div>
  <div class="cards-track" id="cards" tabindex="0" role="region" aria-label={t.collection.preview}>
    {previewHorses.map(horse => <HorseCard horse={horse} copy={t} image={homepageCardImages[horse.images.card]} />)}
  </div>
  <div class="container collection-bottom"><span class="swipe-hint">↔ {t.collection.hint}</span><div class="catalog-teaser"><a href={localizedPath('/horses/',locale)}>{t.collection.cta}<Icon /></a><small>{t.collection.soon}</small></div><span class="collection-spark" aria-hidden="true"><Icon name="star" /></span></div>
</section>
<script>
  const track = document.querySelector<HTMLElement>('.cards-track');
  const scrollCards = (direction: number) => {
    if (!track) return;
    const card = track.querySelector<HTMLElement>('article');
    if (!card) return;
    const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
    track.scrollBy({ left: direction * (card.getBoundingClientRect().width + gap), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-scroll]').forEach(button => button.addEventListener('click', () => scrollCards(Number(button.dataset.scroll))));
  track?.addEventListener('keydown', event => {
    if (event.key === 'ArrowLeft') { event.preventDefault(); scrollCards(-1); }
    if (event.key === 'ArrowRight') { event.preventDefault(); scrollCards(1); }
  });
  document.querySelectorAll<HTMLButtonElement>('[data-card-open]').forEach(button => {
    button.addEventListener('click', () => (document.getElementById(`preview-${button.dataset.cardOpen}`) as HTMLDialogElement)?.showModal());
  });
  document.querySelectorAll<HTMLDialogElement>('.card-dialog').forEach(dialog => {
    dialog.querySelector('[data-card-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') document.querySelector<HTMLDialogElement>('.card-dialog[open]')?.close();
  });
</script>
