---
import { Image, getImage } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import HorseTile from './HorseTile.astro';
import Icon from '../Icon.astro';
import StatIcon from '../StatIcon.astro';
import { orderedHorses, collection } from '../../data/collection';
import { statKeys, type Horse } from '../../data/horse-types';
import { cardImages } from '../../data/assets';
import { getCopy, breedLabel, editionLabel, type Locale } from '../../i18n';
import { localizedPath } from '../../i18n/paths';
import '../../styles/horsedex.css';
interface Props { horse: Horse; locale?: Locale }
const { horse, locale = 'en' } = Astro.props;
const t = getCopy(locale);
const breed = breedLabel(horse.breed, t);
const rarity = horse.rarity === 'normal' ? 'Standard' : t.rarities[horse.rarity];
const editionHorses = orderedHorses.filter(item => item.edition === horse.edition);
const index = editionHorses.findIndex(item => item.id === horse.id);
const previous = editionHorses[index - 1];
const next = editionHorses[index + 1];
const related = orderedHorses.filter(item => item.breed === horse.breed && item.id !== horse.id);
const image = cardImages[horse.images.card];
const shareImage = image ? await getImage({ src: image, width: 700, format: 'webp' }) : undefined;
const alt = t.dex.cardAlt.replace('{name}', horse.name).replace('{rarity}', rarity);
const description = t.dex.metaDescription.replace('{name}',horse.name).replace('{breed}',breed).replace('{id}',horse.id).replace('{rarity}',rarity);
---
<SiteLayout locale={locale} title={`${horse.name} · ${horse.id} — HORSE STARS HorseDex`} description={description} image={shareImage?.src} imageAlt={alt}>
  <div class={`horse-detail dex-rarity-${horse.rarity}`}>
    <div class="container detail-topline"><a class="dex-back" href={localizedPath('/horses/',locale)}><Icon class="rotate-180" />{t.dex.back}</a><span>{editionLabel(horse.edition,t)} / {rarity}</span></div>
    <nav class="container horse-sequence" aria-label={t.dex.sampleNav}>
      {previous ? <a href={localizedPath(`/horses/${previous.slug}/`,locale)} rel="prev"><Icon class="rotate-180" /><span>{t.dex.previous}<small>{previous.name}</small></span></a> : <span class="sequence-disabled" aria-disabled="true"><Icon class="rotate-180" /><span>{t.dex.previous}<small>{t.dex.first}</small></span></span>}
      <span class="sequence-number">{horse.id}<small>/ {horse.edition === 'base' ? collection.total : editionHorses.length}</small></span>
      {next ? <a href={localizedPath(`/horses/${next.slug}/`,locale)} rel="next"><span>{t.dex.next}<small>{next.name}</small></span><Icon /></a> : <span class="sequence-disabled" aria-disabled="true"><span>{t.dex.next}<small>{t.dex.last}</small></span><Icon /></span>}
    </nav>
    <section class="container detail-layout" aria-labelledby="horse-name">
      <div class="detail-art">
        {horse.images.hero && cardImages[horse.images.hero] && <Image class="detail-art-background" src={cardImages[horse.images.hero]} alt="" width={900} loading="lazy" />}
        <div class="detail-orbit" aria-hidden="true"></div>
        <span class="detail-art-label">HORSE STARS / {horse.id}</span>
        {image ? <Image class="detail-card-image" src={image} alt={alt} width={460} widths={[320,460,640,920]} sizes="(max-width: 639px) 75vw, (max-width: 1023px) 40vw, 440px" loading="eager" fetchpriority="high" /> : <div class="horse-placeholder detail-placeholder" role="img" aria-label={`${horse.name} — Horse Stars card artwork`}><span>HORSE<br />STARS</span><strong>{horse.id}</strong></div>}
        <span class="detail-art-rarity"><Icon name="star" />{rarity}</span>
      </div>
      <div class="detail-copy">
        <p class="eyebrow">{horse.id}<span aria-hidden="true">/</span>{editionLabel(horse.edition,t)}</p>
        <h1 id="horse-name">{horse.name}</h1>
        <div class="detail-classification"><span>{breed}</span><span class="dex-rarity-label"><i aria-hidden="true"></i>{rarity}</span></div>
        <div class="detail-total"><div><Icon name="star" /><span>{t.dex.total}</span></div><strong>{horse.total}</strong></div>
        <p class="detail-stats-heading">{t.dex.stats}</p>
        <dl class="detail-stats">{statKeys.map(stat => <div class={`detail-stat stat-${stat}`}><dt><StatIcon stat={stat} />{t.collection[stat]}</dt><dd>{horse.stats[stat]}</dd><div class="detail-stat-track" aria-hidden="true"><span style={`width:${Math.min(100,horse.stats[stat])}%`}></span></div></div>)}</dl>
        {horse.story && <aside class="horse-story" aria-label={t.dex.story}><Icon name="star" /><div><h2>{horse.story.title}</h2><p>{horse.story.hook}</p></div></aside>}
      </div>
    </section>
    <section class="related-section" aria-labelledby="related-title"><div class="container related-heading"><div><p class="eyebrow">{t.dex.relatedLabel}</p><h2 id="related-title">{t.dex.moreBreed.replace('{breed}',breed.toUpperCase())}</h2></div><a href={localizedPath(`/horses/?breed=${encodeURIComponent(horse.breed)}`,locale)}>{t.dex.browseAll}<Icon /></a></div>
      {related.length ? <div class="related-rail" tabindex="0" role="region" aria-label={t.dex.relatedLabel}>{related.map(item => <HorseTile horse={item} copy={t} locale={locale} />)}</div> : <p class="container related-empty">{t.dex.relatedEmpty}</p>}
    </section>
  </div>
</SiteLayout>
