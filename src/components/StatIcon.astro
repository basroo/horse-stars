---
interface Props { stat: string }
const { stat } = Astro.props;
---
<svg class={`stat-icon stat-${stat}`} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {stat === 'speed' && <><path d="M4 18a9 9 0 1 1 16 0M12 12l5-5" /><circle cx="12" cy="12" r="2" /><path d="M5 12H3m9-7V3m7 9h2" /></>}
  {stat === 'power' && <path d="m14 2-9 12h7l-2 8 9-13h-7l2-7Z" />}
  {stat === 'jump' && <><path d="M4 4v16m16-16v16M4 9h16M4 15h16M2 20h4m12 0h4M8 9l4-4 4 4" /></>}
  {stat === 'brains' && <><path d="M12 4c-4-4-9 1-6 5-4 2-2 8 2 8 0 4 4 5 4 1V4Zm0 0c4-4 9 1 6 5 4 2 2 8-2 8 0 4-4 5-4 1" /><path d="m7 8 3 2m7-2-3 2M7 14l3-1m7 1-3-1" /></>}
  {stat === 'total' && <path d="m12 2 3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1 3-6Z" />}
</svg>
